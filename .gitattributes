# 统一换行符，避免 Windows / macOS / Linux 协作时产生整文件 diff
* text=auto eol=lf

# Godot 文本资源
*.gd       text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.godot    text eol=lf
*.md       text eol=lf

# 二进制资源
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.ogg      binary
*.wav      binary
*.mp3      binary
*.ttf      binary
*.otf      binary
